# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# (Optional) Guild ID for instant slash command testing during development
# If left blank, commands are registered globally across all servers
GUILD_ID=

# Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Microsoft Edge Neural TTS Voice (100% Free, no API key needed)
# Popular choices:
# en-US-JennyNeural  (US English - Female)
# en-US-GuyNeural    (US English - Male)
# en-GB-SoniaNeural  (UK English - Female)
# ms-MY-YasminNeural (Malay - Female)
# ms-MY-OsmanNeural  (Malay - Male)
TTS_VOICE=en-US-JennyNeural
