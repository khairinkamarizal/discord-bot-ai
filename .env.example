# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# (Optional) Guild ID for instant slash command testing during development
# If left blank, commands are registered globally across all servers
GUILD_ID=

# ====================================================================
# GOOGLE CLOUD / GEMINI CREDENTIALS (Choose Option 1 or Option 2)
# ====================================================================

# OPTION 1: Google Cloud API Key (or AI Studio Key)
# In Google Cloud Console:
# 1. Enable "Generative Language API" or "Vertex AI API" in your GCP project.
# 2. Go to APIs & Services ➔ Credentials ➔ Create Credentials ➔ API Key.
GEMINI_API_KEY=your_api_key_here

# OPTION 2: Google Cloud Vertex AI (Project + Service Account)
# Uncomment these if using GCP Vertex AI with a service account:
# GCP_PROJECT_ID=your-google-cloud-project-id
# GCP_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Gemini Model (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Microsoft Edge Neural TTS Voice (100% Free, no API key needed)
# Popular choices:
# en-US-JennyNeural  (US English - Female)
# en-US-GuyNeural    (US English - Male)
# en-GB-SoniaNeural  (UK English - Female)
# ms-MY-YasminNeural (Malay - Female)
# ms-MY-OsmanNeural  (Malay - Male)
TTS_VOICE=en-US-JennyNeural
